---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { url } from '../lib/paths';
import { HTML_LANG, OG_LOCALE, ROUTES, UI, type RouteKey } from '../lib/i18n';
import { LANGS, type Lang } from '../schemas/catalog';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** The page's key in ROUTES; omitted on pages without translations (404). */
  route?: RouteKey;
}

const { title, description, lang, route } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og.png'), Astro.site);
const alternates = route
  ? LANGS.map((l) => ({ lang: l, href: new URL(url(ROUTES[route][l]), Astro.site) }))
  : [];
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={HTML_LANG[a.lang]} href={a.href} />
    ))}
    {route && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(url(ROUTES[route].pt), Astro.site)}
      />
    )}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#fcfcfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16181c" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="englishmap" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      {UI[lang].skip}
    </a>
    <SiteHeader lang={lang} route={route} />
    <main id="conteudo">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
