---
import { url } from '../lib/paths';
import { LANG_NAME, ROUTES, UI, type RouteKey } from '../lib/i18n';
import { LANGS, type Lang } from '../schemas/catalog';

interface Props {
  lang: Lang;
  route?: RouteKey | undefined;
}

const { lang, route } = Astro.props;
const t = UI[lang];
const links: { key: RouteKey; label: string }[] = [
  { key: 'home', label: t.navResources },
  { key: 'guide', label: t.navGuide },
];
// On a page without translations, the switcher points to the other language's home.
const other = LANGS.filter((l) => l !== lang);
---

<header class="site-header wrap">
  <a class="brand" href={url(ROUTES.home[lang])}>
    english<span>map</span>
  </a>
  <nav aria-label={t.navLabel}>
    <ul>
      {links.map((l) => (
        <li>
          <a href={url(ROUTES[l.key][lang])} aria-current={route === l.key ? 'page' : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <ul class="langs" aria-label={t.langSwitch}>
    {other.map((l) => (
      <li>
        <a href={url(ROUTES[route ?? 'home'][l])} hreflang={l} lang={l} data-lang-link={l}>
          {LANG_NAME[l]}
        </a>
      </li>
    ))}
  </ul>
  <button class="theme" type="button" aria-label={t.theme}>
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
      <circle
        cx="10"
        cy="10"
        r="7.25"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      ></circle>
      <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
    </svg>
  </button>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode: the choice lasts until the tab closes */
    }
  });

  // Keep the active filters when switching language.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]')) {
    a.addEventListener('click', () => {
      if (location.search) a.href = a.pathname + location.search;
    });
  }
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
    max-width: none;
  }

  .brand {
    font-family: var(--font-entry);
    font-weight: var(--weight-entry);
    font-size: var(--type-h3);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .brand span {
    color: var(--pen);
  }

  nav {
    margin-inline-start: auto;
  }

  ul {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--type-data);
  }

  nav a,
  .langs a {
    text-decoration: none;
    color: var(--ink-2);
  }

  nav a:hover,
  .langs a:hover {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--pen);
    text-decoration-thickness: 2px;
  }

  .langs {
    padding-inline-start: var(--space-5);
    border-inline-start: 1px solid var(--rule);
  }

  .theme {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color var(--duration-ui) var(--ease-out),
      border-color var(--duration-ui) var(--ease-out);
  }

  .theme:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  @media (max-width: 40rem) {
    .site-header {
      flex-wrap: wrap;
      row-gap: var(--space-2);
    }
    .langs {
      margin-inline-start: auto;
      padding: 0;
      border: 0;
    }
    nav {
      order: 3;
      flex-basis: 100%;
      margin: 0;
    }
  }
</style>
