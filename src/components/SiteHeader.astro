---
import { url } from '../lib/paths';
const path = Astro.url.pathname;
const links = [
  { href: url('/'), label: 'Recursos' },
  { href: url('/como-montar/'), label: 'Como montar a imersão' },
];
---

<header class="site-header wrap">
  <a class="brand" href={url('/')}>
    english<span>map</span>
  </a>
  <nav aria-label="Principal">
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <button class="theme" type="button" aria-label="Alternar tema claro e escuro">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
      <circle
        cx="10"
        cy="10"
        r="7.25"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      ></circle>
      <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
    </svg>
  </button>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode: the choice lasts until the tab closes */
    }
  });
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
    max-width: none;
  }

  .brand {
    font-family: var(--font-entry);
    font-weight: var(--weight-entry);
    font-size: var(--type-h3);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .brand span {
    color: var(--pen);
  }

  nav {
    margin-inline-start: auto;
  }

  ul {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--type-data);
  }

  nav a {
    text-decoration: none;
    color: var(--ink-2);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--pen);
    text-decoration-thickness: 2px;
  }

  .theme {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color var(--duration-ui) var(--ease-out),
      border-color var(--duration-ui) var(--ease-out);
  }

  .theme:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  @media (max-width: 34rem) {
    .site-header {
      flex-wrap: wrap;
      row-gap: var(--space-2);
    }
    nav {
      order: 3;
      flex-basis: 100%;
      margin: 0;
    }
    .theme {
      margin-inline-start: auto;
    }
  }
</style>
