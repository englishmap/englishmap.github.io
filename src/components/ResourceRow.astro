---
import type { Lang, Resource } from '../schemas/catalog';
import { COST_LABEL, COST_TITLE, FORMAT_LABEL, UI } from '../lib/i18n';
import LevelStrip from './LevelStrip.astro';

interface Props {
  resource: Resource;
  lang: Lang;
}

const { resource: r, lang } = Astro.props;
const t = UI[lang];
const summary = r.summary[lang];
---

<li
  class="resource"
  data-from={r.from}
  data-to={r.to}
  data-cost={r.cost}
  data-name={r.name}
  data-summary={summary}
>
  <div class="what">
    <a class="name" href={r.url} rel="noopener">
      {r.name}
    </a>
    <p class="summary">{summary}</p>
  </div>
  <dl class="facts">
    <div>
      <dt class="sr-only">{t.format}</dt>
      <dd class="format">{FORMAT_LABEL[lang][r.format]}</dd>
    </div>
    <div>
      <dt class="sr-only">{t.level}</dt>
      <dd>
        <LevelStrip from={r.from} to={r.to} lang={lang} />
      </dd>
    </div>
    <div>
      <dt class="sr-only">{t.cost}</dt>
      <dd class:list={['cost', r.cost]} title={COST_TITLE[lang][r.cost]}>
        {COST_LABEL[lang][r.cost]}
      </dd>
    </div>
  </dl>
</li>

<style>
  .resource {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .resource[hidden] {
    display: none;
  }

  .name {
    font-weight: var(--weight-strong);
    text-decoration-color: transparent;
  }

  .name:hover {
    text-decoration-color: currentColor;
  }

  .summary {
    margin-top: var(--space-1);
    color: var(--ink-2);
    font-size: var(--type-data);
    max-width: var(--measure);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    font-size: var(--type-data);
  }

  dd {
    margin: 0;
  }

  .format {
    color: var(--ink-2);
  }

  .cost.free {
    color: var(--ink);
  }
  .cost.freemium,
  .cost.paid {
    color: var(--ink-2);
  }
  .cost.paid::before {
    content: '$ ';
  }

  @media (min-width: 56rem) {
    .resource {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-6);
      align-items: baseline;
    }
    .facts {
      display: grid;
      grid-template-columns: 6.5rem 7.5rem 4.5rem;
      gap: var(--space-4);
    }
  }
</style>
